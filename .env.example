# ═══════════════════════════════════════════════════════════════════════════
# Alasmia Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` or any real secrets.
#
# Generated by: python main.py setup
# ═══════════════════════════════════════════════════════════════════════════

# ── Companion Settings ──────────────────────────────────────────────────────
COMPANION_GENDER=male
USER_NAME=
USER_LANGUAGE=English

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Supported: minimax, openai, anthropic, ollama, groq, openai-compatible
MODEL_PROVIDER=minimax

# Model names
# MiniMax: minimax-m2.7 (default)
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-sonnet-4, claude-opus-4, claude-3-5-sonnet
# Ollama: qwen2.5:14b, llama3.2:3b, mistral:7b
# Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
MODEL_NAME=minimax-m2.7

# ── API Keys ─────────────────────────────────────────────────────────────────
# Provider-specific keys (uncomment and fill)

# MiniMax (default)
# MINIMAX_API_KEY=***

# OpenAI
# OPENAI_API_KEY=***
# OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=***

# Groq
# GROQ_API_KEY=***

# Generic fallback (used when provider-specific key is absent)
API_KEY=

# ── Ollama (Local) ───────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Channels ─────────────────────────────────────────────────────────────────
# Comma-separated list: cli,telegram,discord,whatsapp
ENABLED_CHANNELS=cli

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# WhatsApp
WHATSAPP_SESSION_PATH=./whatsapp_session

# ── Proactive AI ─────────────────────────────────────────────────────────────
PROACTIVE_ENABLED=true
MORNING_CHECKIN=8:00 AM
EVENING_CHECKIN=7:00 PM

# ── Advanced Settings ─────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Autonomy level: supervised, moderate, full (like YOLO mode)
AUTONOMY_LEVEL=supervised

# ── Memory & Persistence ──────────────────────────────────────────────────────
MEMORY_DIR=./memory
DATA_DIR=./data

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per minute (0 = unlimited)
RATE_LIMIT=0

# ── Development ──────────────────────────────────────────────────────────────
DEBUG=false
ADVANCED_MODE=false