# Alasmia Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# MODEL CONFIGURATION
# ===========================================

# AI Model Provider: ollama, openai, anthropic, xai
MODEL_PROVIDER=ollama

# Model name
MODEL_NAME=qwen2.5:14b

# For Ollama
OLLAMA_URL=http://localhost:11434

# For OpenAI (e.g., gpt-4, gpt-4-turbo)
# OPENAI_API_KEY=sk-your-api-key-here

# For Anthropic (e.g., claude-3-opus, claude-3-sonnet)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# For xAI (e.g., grok-2, grok-2-mini)
# XAI_API_KEY=your-xai-api-key-here

# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================

# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ===========================================
# WHATSAPP CONFIGURATION
# ===========================================

# From Meta Business Developer Portal
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Webhook verification token (set your own random string)
WHATSAPP_WEBHOOK_VERIFY=change_me_to_random_string

# WhatsApp API version (default: v18.0)
WHATSAPP_API_VERSION=v18.0

# ===========================================
# DISCORD BOT CONFIGURATION
# ===========================================

# Get token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# ===========================================
# ADVANCED SETTINGS
# ===========================================

# Advanced Mode (allows mature content conversations)
ADVANCED_MODE=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data directory (default: ./data)
DATA_DIR=./data

# Enable proactive messaging (default: true)
PROACTIVE_ENABLED=true

# Max daily proactive messages per user (default: 4)
MAX_DAILY_PROACTIVE=4
